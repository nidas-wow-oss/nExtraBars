<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
..\FrameXML\UI.xsd">
	<Script file="NEB_ButtonTemplate.lua"/>
	<CheckButton name="NEB_ButtonTemplate" inherits="SecureActionButtonTemplate, ActionButtonTemplate" virtual="true">
		<Scripts>
			<OnLoad>
				NEB_ABT_OnLoad(self);
			</OnLoad>
			<PreClick>
				NEB_ABT_PreClick(self);
			</PreClick>
			<PostClick>
				NEB_ABT_PostClick(self);
				NEB_ABT_UpdateChecked(self);
			</PostClick>
			<OnReceiveDrag>
				NEB_ABT_OnReceiveDrag(self);
			</OnReceiveDrag>
			<OnDragStart>
				NEB_ABT_OnDragStart(self);
			</OnDragStart>
			<OnEnter>
				NEB_ABT_UpdateTooltip(self);
			</OnEnter>
			<OnLeave>
				GameTooltip:Hide();
			</OnLeave>
			<OnUpdate>
				NEB_ABT_OnUpdate(self, elapsed);
			</OnUpdate>
		</Scripts>
		<Attributes>
			<Attribute name="type" value="none"/>
			<Attribute name="spell" value=""/>
			<Attribute name="item" value=""/>
			<Attribute name="macro" value=""/>
			<Attribute name="saveentries" value=""/>
			<Attribute name="savesettings" value=""/>
		</Attributes>
	</CheckButton>
</Ui>
